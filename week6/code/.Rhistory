# Subset the data for expo.time.min = 0 and expo.time.min != 0
data_expo_0 <- subset(cricketdata, expo.time.min == 0)
data_expo_not_0 <- subset(cricketdata, expo.time.min != 0)
# Perform a t-test
t_test_result <- t.test(data_expo_0$no.enc1, data_expo_not_0$no.enc1)
# Print the result
