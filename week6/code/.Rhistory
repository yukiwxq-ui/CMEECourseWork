#####inter-reliability test
# Select the columns representing observations from two observers
observed_data <- cricketdata[, c("highest.level1", "highest.level2")]
# Calculate Kendall's coefficient of concordance
kendall_result <- kendall(observed_data, correct = TRUE)
# Extract the W value (Kendall's coefficient of concordance) for highest.level1 and highest.level2
kendall_w <- kendall_result$value
# Print the calculated W value
kendall_w ####0.9953344
