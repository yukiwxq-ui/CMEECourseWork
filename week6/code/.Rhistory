# === Aedes aegypti ODE Simulation Model with Real Climate Data ===
library(deSolve)
library(ggplot2)
library(readr)
library(scales)
library(dplyr)
library(lubridate)
climate_data <- read_csv("FYP/florida_climate.csv")
climate_data$date <- as.Date(climate_data$date, format = "%d/%m/%Y")
temperature_data <- climate_data$temperature
rainfall_data <- climate_data$rainfall
time <- 0:(length(temperature_data) - 1)
times <- seq(0, 365, by = 1)
temp_func <- approxfun(x = time, y = temperature_data, rule = 2)
rain_func <- approxfun(x = time, y = rainfall_data, rule = 2)
# φ (phi) - oviposition rate
phi_fun <- function(T) {
return(3.09 + 0.28*T - 0.02*T^2 + 3.6e-4*T^3 - 2.4e-6*T^4)}
# α (alpha) - maturation rate
alpha_fun <- function(T) {
return(0.131 + (-5.723*10^-2)*T + (1.164*10^-2)*T^2 + (-1.341*10^-3)*T^3 + 8.723*10^-5*T^4 +
(-3.017*10^-6)*T^5 + 5.153*10^-8*T^6 + (-3.420*10^-10)*T^7)}
# μ1 (mu1) - aquatic mortality rate
mu1_temp_fun <- function(T) {
return(2.130 - 3.797*10^-1*T + 2.457*10^-2*T^2 - 6.778*10^-4*T^3 + 6.794*10^-6*T^4)}
# μ2 (mu2) - adult mortality rate
mu2_fun <- function(T) {
return(0.19 - 0.006*T + 1.2e-4*T^2 - 9.3e-7*T^3 + 2.6e-9*T^4)}
# Rainfall-dependent carrying capacity C(r) and part of mu1(r)
C_fun <- function(r, r1 = 0.1, r2 = 110.49, y = 0.500000133, C1 = 100, C2 = 2000) {
ratio <- (r - r1)/(r2 - r1)
ratio <- pmax(0, ratio)
return(C1 + (C2 - C1) * ratio^y)}
mu1_rain_fun <- function(r, r1 = 0.1, r2 = 110.49, y = 1.999602672, mu1_1 = 0.01397, mu1_2 = -0.06001) {
ratio <- (r - r1)/(r2 - r1)
ratio <- pmin(1, pmax(0, ratio))
return(mu1_1 + (mu1_2 - mu1_1) * ratio^y)}
mu1_total <- function(T, r) {
return(mu1_temp_fun(T) + mu1_rain_fun(r))}
aedes_model <- function(t, state, parameters) {
with(as.list(c(state, parameters)), {
T <- temp_func(t)
R <- rain_func(t)
phi <- phi_fun(T)
alpha <- alpha_fun(T)
mu1 <- mu1_total(T, R)
mu2 <- mu2_fun(T)
C <- C_fun(R)
dA <- epsilon * phi * (1 - A/C) * F - (alpha + mu1 + u1) * A
dF <- gamma * alpha * A - (mu2 + u2) * F
list(c(dA, dF))})}
parameters <- list(epsilon = 0.5,gamma = 0.5,u1 = 0.0,u2 = 0.0)
ggplot(climate_data, aes(x = date)) +
geom_bar(aes(y = rainfall), stat = "identity", fill = "#95B4CC", alpha = 1.0) +
geom_line(aes(y = -10, colour = "Rainfall"), size = 0.1, show.legend = TRUE) +
geom_line(aes(y = temperature * 5, colour = "Temperature"), size = 0.8) +
geom_smooth(aes(y = rainfall, colour = "Rainfall (smoothed)"),
method = "loess", se = FALSE, linetype = "solid", size = 1) +
geom_smooth(aes(y = temperature * 5, colour = "Temperature (smoothed)"),
method = "loess", se = FALSE, linetype = "solid", size = 1) +
geom_point(aes(y = -10, colour = "Rainfall"), shape = 22, size = 5, show.legend = TRUE)+
scale_y_continuous(
name = "Rainfall (mm)",
limits = c(0, 180),
breaks = seq(0, 180, by = 20),
expand = c(0, 0),
sec.axis = sec_axis(
~ . / 5,
name = "Temperature (°C)",
breaks = seq(0, 36, by = 4)))+
scale_x_date(
date_breaks = "1 month",
labels = date_format("%b"),
expand = c(0, 0),
sec.axis = dup_axis(labels = NULL, name = NULL))+
scale_colour_manual(
name = NULL,
values = c(
"Rainfall" = "#95B4CC",
"Rainfall (smoothed)" = "#4F7EBB",
"Temperature" = "#F4A6A6",
"Temperature (smoothed)" = "#BC3D41")) +
guides(
colour = guide_legend(
override.aes = list(
linetype = c("blank", "solid", "solid", "solid"),
shape = c(22, NA, NA, NA),
fill = c("#95B4CC", NA, NA, NA),
colour = c("#95B4CC", "#4F7EBB", "#F4A6A6", "#BC3D41"),
size = 1.2))) +
labs(
title = "Daily Rainfall and Temperature Trends in Collier County in 2015",
x = "Month") +
theme_classic() +
theme(
axis.ticks.length = unit(-5, "pt"),
axis.title.y = element_text(size = 13),
axis.title.y.right = element_text(size = 13),
axis.title.x = element_text(size = 13),
axis.text = element_text(size = 10),
plot.title = element_text(size = 15, hjust = 0.5),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
legend.position = c(0.98, 0.98),
legend.justification = c(1, 1),
legend.background = element_rect(fill = "white", colour = "black"),
legend.text = element_text(size = 8),
legend.key.height = unit(0.5, "lines"),
legend.key.width = unit(1, "lines"),
axis.line.x.top = element_line(colour = "black"),
axis.ticks.x.top = element_line(colour = "black"),
axis.title.x.top = element_text(size = 13),
axis.text.x.top = element_text(size = 10),)
state <- c(A = 200, F = 100)
out <- ode(y = state, times = times, func = aedes_model, parms = parameters)
out_df <- as.data.frame(out)
out_df$time_date <- as.Date("2015-01-01") + out_df$time - 1
ggplot(out_df, aes(x = time_date)) +
geom_line(aes(y = A, colour = "Aquatic stage"), size = 0.7, linetype = "solid") +
geom_line(aes(y = F, colour = "Adult females"), size = 0.7, linetype = "solid") +
geom_smooth(aes(y = A, colour = "Aquatic stage (smoothed)"), method = "loess", se = FALSE, linetype = "solid", size = 0.7) +
geom_smooth(aes(y = F, colour = "Adult females (smoothed)"), method = "loess", se = FALSE, linetype = "solid", size = 0.7) +
scale_colour_manual(
name = NULL,
values = c(
"Adult females" = "#E78C8C",
"Aquatic stage" = "#95B4CC",
"Adult females (smoothed)" = "#BC3D41",
"Aquatic stage (smoothed)" = "#4F7EBB")) +
scale_x_date(
date_labels = "%b",
date_breaks = "1 month",
expand = c(0, 0),
sec.axis = dup_axis(name = NULL, labels = NULL)) +
scale_y_continuous(
limits = c(0, 500),
breaks = seq(0, 500, by = 50),
expand = c(0, 0),
sec.axis = dup_axis(name = NULL, labels = NULL)) +
labs(
title = expression("Simulated"~ italic("Aedes aegypti") ~ "Population Dynamics in Collier County in 2015"),
x = "Month",
y = "Population") +
theme_minimal() +
theme(
axis.line = element_line(colour = "black", linewidth = 0.6),
axis.ticks = element_line(colour = "black"),
axis.ticks.length = unit(-5, "pt"),
axis.line.x.top = element_line(colour = "black", linewidth = 0.6),
axis.ticks.x.top = element_line(colour = "black"),
axis.ticks.length.top = unit(-5, "pt"),
axis.text.x.top = element_blank(),
axis.title.x.top = element_blank(),
axis.title = element_text(size = 13),
axis.text = element_text(size = 10),
plot.title = element_text(size = 15, face = "bold", hjust = 0.5),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
legend.position = c(0.98, 0.98),
legend.justification = c(1, 1),
legend.background = element_rect(colour = "black", fill = "white"),
legend.key.height = unit(0.5, "lines"),
legend.key.width = unit(0.8, "lines"),
legend.text = element_text(size = 8),
legend.title = element_blank())
#-----Model Validation-----
obs_daily <- read_csv("FYP/model_validation_data.csv")
obs_daily$date <- as.Date(obs_daily$date, format = "%d/%m/%Y")
obs_daily$F_obs <- obs_daily$total_count * 0.5 #female adult population
obs_daily$week <- isoweek(obs_daily$date)# new week number label
obs_weekly <- obs_daily %>%
group_by(week) %>%
summarise(F_obs_week = sum(F_obs, na.rm = TRUE)/7)
out_df$time_date <- as.Date("2015-01-01") + out_df$time - 1
out_df$week <- isoweek(out_df$time_date)
# 计算每周模拟的平均雌蚊数量（未乘 scale factor）
sim_weekly <- out_df %>%
group_by(week) %>%
summarise(F_sim_week = mean(F, na.rm = TRUE))
validation_weekly <- left_join(obs_weekly, sim_weekly, by = "week")
# RMSE
val_filtered <- validation_weekly %>% filter(!is.na(F_obs_week), !is.na(F_sim_week)) # 只用有观测值的周
rmse <- sqrt(mean((val_filtered$F_sim_week - val_filtered$F_obs_week)^2))
cat("RMSE =", rmse, "\n")
# -----Model curve adjustments-----
# shift simulated
if (best_lag >= 0) {
shifted_sim <- dplyr::lag(val_filtered$F_sim_week, n = best_lag)
} else {
shifted_sim <- dplyr::lead(val_filtered$F_sim_week, n = abs(best_lag))
}
View(validation_weekly)
View(obs_daily)
