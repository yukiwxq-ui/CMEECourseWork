          file = "../results/PP_Regress_Results.csv", 
          row.names = FALSE)

library(scales)

library(scales)
library(grid)

pp_plot <- ggplot(
  pp_data_clean,
  aes(
    x = Prey.mass,
    y = Predator.mass,
    colour = Predator.lifestage
  )
) +
  geom_point(alpha = 0.8, size = 2, shape = 3) + 
  geom_smooth(
    method = "lm",
    se = TRUE,
    fill = "grey70",
    alpha = 0.3,
    aes(group = Predator.lifestage)
  ) +

  scale_x_continuous(
    name = "Prey Mass (g)",
    labels = scales::scientific
  ) +
  scale_y_continuous(
    name = "Predator Mass (g)",
    labels = scales::scientific
  ) +

  facet_wrap(
    ~ Type.of.feeding.interaction,
    ncol = 1,
    scales = "free_y",
    strip.position = "right"
  ) +

  # 🎨 deeper macaron palette (not washed out)
  scale_colour_manual(
    name = "Predator lifestage",
    values = c(
      "adult" = "#7BC8A4",         # mint green
      "juvenile" = "#FFB3BA",      # rose candy pink
      "larva" = "#FFDF8E",         # pastel yellow
      "larva/juvenile" = "#A9D2FF",# baby blue
      "postlarva" = "#C49CDE",     # purple macaron
      "postlarva/juvenile" = "#FF9AA2" # warm pink
    )
  ) +

  # 📏 compress horizontal width to ~2/5 look
  coord_cartesian(expand = FALSE) +
  theme_bw() +
  theme(
    strip.placement = "outside",
    strip.text = element_text(size = 8),
    panel.grid.minor = element_blank(),
    legend.position = "bottom",
    legend.direction = "horizontal",
    legend.box = "horizontal",
    legend.title = element_text(size = 9),
    legend.text = element_text(size = 8),

    # 🔥 very important: reduce panel width feeling
    panel.spacing.x = unit(-1.0, "lines"),

    # give breathing room on left/right margin
    plot.margin = margin(5, 40, 5, 5),

    # remove large facet background width feeling
    strip.background = element_rect(fill = "white")
  ) +
  guides(
    colour = guide_legend(nrow = 1)
  )

# Save the plot as PDF
pdf("../results/PP_Regress.pdf", width = 10, height = 8)
print(pp_plot)
dev.off()

# Print summary message
cat("Analysis completed successfully!\n")
cat("Number of feeding type - lifestage combinations:", nrow(regression_results), "\n")
cat("Plot saved to: ../results/PP_Regress.pdf\n")
cat("Results saved to: ../results/PP_Regress_Results.csv\n")
