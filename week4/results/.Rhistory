ggplot(df, aes(x = x, y = y)) +
  geom_point(shape = 3, size = 3) +  # + 形状

  scale_x_log10(
    breaks = c(1e-07, 1e-03, 1e+01),
    labels = c(
      expression(1e^-07),
      expression(1e^-03),
      expression(1e^+01)
    )
  ) +

  scale_y_log10(
    breaks = c(1e-06, 1e-02, 1e+02, 1e+06),
    labels = c(
      expression(1e^-06),
      expression(1e^-02),
      expression(1e^+02),
      expression(1e^+06)
    )
  ) +

  theme_minimal(base_size = 13) +
  theme(
    legend.position = "top",
    legend.direction = "horizontal",
    panel.grid.minor = element_blank(),
    plot.margin = margin(5, 5, 5, 5)
  )


