# Create the plot
pp_plot <- ggplot(pp_data_clean, 
                  aes(x = Prey.mass, y = Predator.mass, 
                      color = Predator.lifestage, 
                      shape = Predator.lifestage)) +
  geom_point(alpha = 0.7, size = 2) +
  geom_smooth(method = "lm", se = FALSE, aes(group = Predator.lifestage)) +
  scale_x_log10(
    name = "Prey Mass in grams",
    breaks = scales::trans_breaks("log10", function(x) 10^x),
    labels = scales::trans_format("log10", scales::math_format(10^.x))
  ) +
  scale_y_log10(
    name = "Predator Mass in grams",
    breaks = scales::trans_breaks("log10", function(x) 10^x),
    labels = scales::trans_format("log10", scales::math_format(10^.x))
  ) +
  facet_wrap(~ Type.of.feeding.interaction, scales = "free", ncol = 3) +
  scale_color_manual(
    name = "Predator lifestage",
    values = c("adult" = "#1f77b4", 
               "juvenile" = "#ff7f0e", 
               "larva" = "#2ca02c",
               "larva/juvenile" = "#d62728", 
               "postlarva" = "#9467bd",
               "postlarva/juvenile" = "#8c564b")
  ) +
  scale_shape_manual(
    name = "Predator lifestage",
    values = c("adult" = 16, 
               "juvenile" = 17, 
               "larva" = 15,
               "larva/juvenile" = 3, 
               "postlarva" = 18,
               "postlarva/juvenile" = 8)
  ) +
  theme_bw() +
  theme(
    panel.grid.minor = element_blank(),
    strip.background = element_rect(fill = "white"),
    legend.position = "bottom",
    axis.text = element_text(size = 8),
    axis.title = element_text(size = 10),
    strip.text = element_text(size = 8),
    legend.text = element_text(size = 8)
  ) +
  guides(color = guide_legend(nrow = 2), shape = guide_legend(nrow = 2))

