  )

# Function to perform regression and extract results
get_regression_results <- function(data) {
  if(nrow(data) < 2) return(NULL)
  
  model <- lm(log10(Predator.mass) ~ log10(Prey.mass), data = data)
  summary_model <- summary(model)
  anova_model <- anova(model)
  
  return(data.frame(
    slope = coef(model)[2],
    intercept = coef(model)[1],
    R_squared = summary_model$r.squared,
    F_statistic = anova_model$F[1],
    p_value = anova_model$`Pr(>F)`[1],
    n = nrow(data)
  ))
}

# Perform regression analysis by feeding type and lifestage
regression_results <- pp_data_clean %>%
  group_by(Type.of.feeding.interaction, Predator.lifestage) %>%
  filter(n() >= 2) %>%  # Need at least 2 points for regression
  group_modify(~ get_regression_results(.x)) %>%
  ungroup() %>%
  filter(!is.na(slope))

# Save regression results to CSV
write.csv(regression_results, 
          file = "../results/PP_Regress_Results.csv", 
          row.names = FALSE)

library(scales)

library(scales)
library(grid)

library(scales)
library(grid)

# Morandi palette
morandi_cols <- c(
  "adult" = "#A6A5A1",          # stone grey
  "juvenile" = "#D4C5A9",       # muted beige
  "larva" = "#9AA7A0",          # moss grey-green
  "larva/juvenile" = "#B7A1A9", # dusty mauve
  "postlarva" = "#C6B8B4",      # warm clay
  "postlarva/juvenile" = "#8F9BA6" # steel blue-grey
)

pp_plot <- ggplot(
  pp_data_clean,
  aes(
    x = Prey.mass,
    y = Predator.mass,
    colour = Predator.lifestage
  )
) +
  geom_point(alpha = 0.8, size = 2, shape = 3) +   # '+' points
  geom_smooth(
    method = "lm",
    se = TRUE,
    fill = "grey70",
    alpha = 0.3,
    aes(group = Predator.lifestage)
  ) +

  # e-notation axes (not log)
  scale_x_continuous(
    name = "Prey mass (g)",
    labels = scales::scientific
  ) +
  scale_y_continuous(
    name = "Predator mass (g)",
    labels = scales::scientific
  ) +

  facet_wrap(
    ~ Type.of.feeding.interaction,
    ncol = 1,
    scales = "free_y",
    strip.position = "right"
  ) +

  # Keep original colours for now (will change to Morandi later)
  scale_colour_manual(
    name = "Predator lifestage",
    values = c(
      "adult" = "#1f77b4",
      "juvenile" = "#ff7f0e",
      "larva" = "#2ca02c",
      "larva/juvenile" = "#d62728",
      "postlarva" = "#9467bd",
      "postlarva/juvenile" = "#8c564b"
    )
  ) +

  theme_bw() +
  theme(
    strip.placement = "outside",
    strip.text = element_text(size = 8),
    panel.grid.minor = element_blank(),
    legend.position = "bottom",
    legend.title = element_text(size = 9),
    legend.text = element_text(size = 8),
    strip.background = element_rect(fill = "white")
  ) +
  guides(colour = guide_legend(nrow = 1))   # ✅ put key on one row

# Save the plot as PDF
pdf("../results/PP_Regress.pdf", width = 10, height = 8)
print(pp_plot)
dev.off()

# Print summary message
cat("Analysis completed successfully!\n")
cat("Number of feeding type - lifestage combinations:", nrow(regression_results), "\n")
cat("Plot saved to: ../results/PP_Regress.pdf\n")
cat("Results saved to: ../results/PP_Regress_Results.csv\n")
