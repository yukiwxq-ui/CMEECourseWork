# PP_Regress.R
# Script to generate predator-prey regression analysis and plots

# Load required packages
suppressPackageStartupMessages({
  library(ggplot2)
  library(dplyr)
  library(tidyr)
})

# Read the data
data_path <- "../data/EcolArchives-E089-51-D1.csv"
pp_data <- read.csv(data_path, stringsAsFactors = FALSE)

# Data cleaning and preparation
pp_data_clean <- pp_data %>%
  filter(!is.na(Predator.mass), !is.na(Prey.mass),
         Predator.mass > 0, Prey.mass > 0) %>%
  mutate(
    Predator.lifestage = case_when(
      Predator.lifestage == "larva / juvenile" ~ "larva/juvenile",
      Predator.lifestage == "postlarva/juvenile" ~ "postlarva/juvenile",
      TRUE ~ Predator.lifestage
    )
  )

# Improved function to perform regression and extract results
get_regression_results <- function(data) {
  if(nrow(data) < 2) return(NULL)
  
  # Check if there's enough variation for regression
  if(sd(data$Predator.mass) == 0 | sd(data$Prey.mass) == 0) return(NULL)
  
  model <- lm(log10(Predator.mass) ~ log10(Prey.mass), data = data)
  
  # Check for perfect fit to avoid ANOVA warnings
  if(deviance(model) < .Machine$double.eps) return(NULL)
  
  summary_model <- summary(model)
  anova_model <- anova(model)
  
  return(data.frame(
    slope = coef(model)[2],
    intercept = coef(model)[1],
    R_squared = summary_model$r.squared,
    F_statistic = ifelse(is.na(anova_model$F[1]), NA, anova_model$F[1]),
    p_value = ifelse(is.na(anova_model$`Pr(>F)`[1]), NA, anova_model$`Pr(>F)`[1]),
    n = nrow(data)
  ))
}

# Perform regression analysis by feeding type and lifestage
regression_results <- pp_data_clean %>%
  group_by(Type.of.feeding.interaction, Predator.lifestage) %>%
  filter(n() >= 2) %>%  # Need at least 2 points for regression
  group_modify(~ get_regression_results(.x)) %>%
  ungroup() %>%
  filter(!is.na(slope))

# Save regression results to CSV
write.csv(regression_results, 
          file = "../results/PP_Regress_Results.csv", 
          row.names = FALSE)

# Create the plot - MODIFIED TO MATCH REFERENCE IMAGE
pp_plot <- ggplot(pp_data_clean, 
                  aes(x = Prey.mass, y = Predator.mass)) +
  geom_point(aes(shape = Predator.lifestage, color = Predator.lifestage), 
             size = 2, alpha = 0.8) +
  geom_smooth(method = "lm", se = FALSE, 
              aes(color = Predator.lifestage, group = Predator.lifestage),
              linewidth = 0.7) +
  scale_x_log10(
    name = "Prey Mass in grams",
    breaks = 10^seq(-10, 10, by = 2),
    labels = scales::trans_format("log10", scales::math_format(10^.x))
  ) +
  scale_y_log10(
    name = "Predator Mass in grams",
    breaks = 10^seq(-5, 15, by = 5),
    labels = scales::trans_format("log10", scales::math_format(10^.x))
  ) +
  facet_wrap(~ Type.of.feeding.interaction, scales = "free", ncol = 3) +
  scale_color_manual(
    name = "Predator.lifestage",  # Changed to match image exactly
    values = c(
      "adult" = "red",
      "juvenile" = "blue", 
      "larva" = "green3",
      "larva/juvenile" = "orange",
      "postlarva" = "purple",
      "postlarva/juvenile" = "brown"
    )
  ) +
  scale_shape_manual(
    name = "Predator.lifestage",  # Changed to match image exactly
    values = c(
      "adult" = 16,        # filled circle
      "juvenile" = 17,     # filled triangle  
      "larva" = 15,        # filled square
      "larva/juvenile" = 3, # plus
      "postlarva" = 18,    # filled diamond
      "postlarva/juvenile" = 8 # star
    )
  ) +
  theme_bw() +
  theme(
    panel.grid.major = element_line(color = "grey90", linewidth = 0.2),
    panel.grid.minor = element_blank(),
    panel.border = element_rect(color = "black", fill = NA, linewidth = 0.5),
    strip.background = element_rect(fill = "white", color = "black", linewidth = 0.5),
    strip.text = element_text(face = "bold", size = 10),
    axis.title = element_text(face = "bold", size = 12),
    axis.text = element_text(size = 9, color = "black"),
    legend.position = "bottom",
    legend.title = element_text(face = "bold", size = 10),
    legend.text = element_text(size = 9),
    legend.key = element_rect(fill = "white"),
    legend.box.spacing = unit(0.2, "cm"),
    plot.margin = unit(c(0.5, 0.5, 0.5, 0.5), "cm")
  ) +
  guides(
    color = guide_legend(
      title = "Predator.lifestage",
      nrow = 1,  # Single row legend
      keywidth = unit(1, "cm"),
      keyheight = unit(0.5, "cm")
    ),
    shape = guide_legend(
      title = "Predator.lifestage", 
      nrow = 1,  # Single row legend
      keywidth = unit(1, "cm"),
      keyheight = unit(0.5, "cm")
    )
  )

# Save the plot as PDF
pdf("../results/PP_Regress.pdf", width = 12, height = 9)  # Adjusted dimensions
print(pp_plot)
dev.off()

# Print summary message
cat("Analysis completed successfully!\n")
cat("Number of feeding type - lifestage combinations:", nrow(regression_results), "\n")
cat("Plot saved to: ../results/PP_Regress.pdf\n")
cat("Results saved to: ../results/PP_Regress_Results.csv\n")
